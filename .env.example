# Copy this file to .env and fill in your mail provider details.
# Restart the server after saving.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=true

# Gmail: you MUST use an App Password (Google Account → Security → App passwords),
# not your normal sign-in password. Spaces in the 16-character app password are OK;
# the app strips them for SMTP.
# If App passwords are not available for your account, use Outlook SMTP or Resend/SendGrid.
